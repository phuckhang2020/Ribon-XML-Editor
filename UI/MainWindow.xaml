<Window x:Class="RibbonXmlEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ribon Studio"
        Width="1180" Height="790" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="RIBON STUDIO" Tag="L:main.eyebrow" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Tùy chỉnh Ribbon cho Excel" Tag="L:main.title" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="Gán macro và sắp xếp các nút Ribbon trực tiếp trong workbook." Tag="L:main.subtitle" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="OpenButton" Content="Mở workbook..." Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenButton_Click" />
            <Button x:Name="SettingsButton" Content="⚙"
                    Width="38" Height="38" FontSize="19" Padding="0" Margin="0,0,170,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingsButton_Click"
                    ToolTip="Mở cài đặt ngôn ngữ" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="9" Background="#EAF1FF" VerticalAlignment="Center">
                    <TextBlock Text="XLS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="WorkbookNameText" Text="Chưa mở workbook" Tag="L:main.noWorkbook" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="WorkbookPathText" Text="Chọn một file .xlsm hoặc .xlam để bắt đầu" Tag="L:main.chooseWorkbook"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="SaveStateText" Text="Chưa có file" Tag="L:main.noFile" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock Text="Ribbon được lưu bên trong workbook đã chọn" Tag="L:main.embedded" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="NÚT RIBBON" Tag="L:main.buttons" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="ButtonCountText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="GROUP TÙY CHỈNH" Tag="L:main.groups" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="GroupCountText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="MACRO ĐÃ QUÉT" Tag="L:main.macros" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="MacroCountText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Các nút đã cấu hình" Tag="L:main.configured" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Chọn một nút để sửa, đổi thứ tự hoặc xóa." Tag="L:main.selectionHint" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RibbonOptionsButton" Content="⚙  Tùy chọn Ribbon" Tag="L:main.ribbonOptions" Click="RibbonOptionsButton_Click" IsEnabled="False" />
                        <Button x:Name="MoveUpButton" Content="↑  Lên" Tag="L:main.moveUp" Click="MoveUpButton_Click" IsEnabled="False" />
                        <Button x:Name="MoveDownButton" Content="↓  Xuống" Tag="L:main.moveDown" Click="MoveDownButton_Click" IsEnabled="False" />
                        <Button x:Name="EditButton" Content="Sửa" Tag="L:main.edit" Click="EditButton_Click" IsEnabled="False" />
                        <Button x:Name="DeleteButton" Content="Xóa" Tag="L:main.delete" Click="DeleteButton_Click" IsEnabled="False" />
                        <Button x:Name="AddTextGroupButton" Content="+  Thêm nhãn" Tag="L:main.addTextGroup" Click="AddTextGroupButton_Click" IsEnabled="False" />
                        <Button x:Name="AddButton" Content="+  Thêm nút" Tag="L:main.addButton" Style="{StaticResource PrimaryButtonStyle}" Click="AddButton_Click" IsEnabled="False" Margin="0" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tìm nhanh" Tag="L:main.search" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="SearchBox" Width="290" ToolTip="Tìm theo tên nút, group, vị trí hoặc macro" Tag="L:main.searchHint"
                                 TextChanged="SearchBox_TextChanged" />
                    </StackPanel>
                    <TextBlock x:Name="ResultCountText" Text="0 mục" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="ButtonGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="ButtonGrid_SelectionChanged" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F5"
                              Background="White" BorderThickness="0" RowHeaderWidth="0"
                              ColumnHeaderHeight="38" RowHeight="48" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NÚT / NỘI DUNG" Binding="{Binding ButtonDisplay}" Width="1.2*" />
                            <DataGridTextColumn Header="GROUP" Binding="{Binding Item.GroupLabel}" Width="1.1*" />
                            <DataGridTextColumn Header="VỊ TRÍ TRÊN RIBBON" Binding="{Binding Location}" Width="1.5*" />
                            <DataGridTextColumn Header="MACRO ĐƯỢC GÁN" Binding="{Binding Button.MacroName}" Width="1.25*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="EmptyStatePanel" Background="#FFFFFF" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock Text="Chưa có nút Ribbon nào" Tag="L:main.emptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Mở workbook, sau đó thêm nút và gán macro để tạo Ribbon riêng." Tag="L:main.emptyDescription"
                                       Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <Button Content="Mở workbook Excel" Tag="L:main.openExcel" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center" Click="OpenButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="Lưu ý: workbook cần được đóng trong các cửa sổ Excel khác khi chỉnh sửa. Mở lại file trong Excel sau khi lưu để xem thay đổi." Tag="L:main.saveHint"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="SaveButton" Content="Lưu thay đổi vào file" Tag="L:main.save" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right" Click="SaveButton_Click" IsEnabled="False" Margin="0" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="Ribon Studio  ·  Công cụ tùy chỉnh Ribbon cho Excel" Tag="L:main.footer"
                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,12,0,0" />
    </Grid>
</Window>
