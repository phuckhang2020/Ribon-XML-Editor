<Window x:Class="RibbonXmlEditor.UI.ImageMsoPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn biểu tượng Office" Tag="L:iconPicker.title" Width="480" Height="570" MinWidth="400" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Biểu tượng Office" Tag="L:iconPicker.heading" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Tìm theo tên imageMso. Xem trước hình thật trong Excel sau khi lưu." Tag="L:iconPicker.hint"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10"
                 ToolTip="Ví dụ: chart, filter, save" TextChanged="SearchBox_TextChanged" />
        <ListBox x:Name="IconList" Grid.Row="2" SelectionChanged="IconList_SelectionChanged"
                 MouseDoubleClick="IconList_MouseDoubleClick" />
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="SelectedIconText" Text="Chưa chọn biểu tượng" Tag="L:iconPicker.selectedNone"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Tag="L:common.cancel" IsCancel="True" Width="85" />
                <Button Content="Chọn" Tag="L:common.choose" IsDefault="True" Width="90" Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="AcceptButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
