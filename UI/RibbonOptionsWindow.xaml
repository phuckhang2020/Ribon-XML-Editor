<Window x:Class="RibbonXmlEditor.UI.RibbonOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tùy chọn Ribbon" Tag="L:options.title" Width="540" Height="680" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Tùy chọn Ribbon" Tag="L:options.title" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Các thiết lập này được nhúng trong workbook đang chỉnh sửa." Tag="L:options.hint"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="StartFromScratchCheck" Content="Ẩn Ribbon mặc định và chỉ hiển thị các tab được chọn" Tag="L:options.scratch"
                          FontWeight="SemiBold" />
                <TextBlock Text="Tạo customUI với startFromScratch=&quot;true&quot;. Chỉ áp dụng khi mở chính workbook này." Tag="L:options.scratchHint"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="24,7,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Tab có sẵn của Excel" Tag="L:options.builtin" FontWeight="SemiBold" />
                    <TextBlock Text="Bỏ chọn để ẩn tab đó. Khi bật startFromScratch, chỉ các tab được chọn sẽ xuất hiện." Tag="L:options.tabsHint"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TabsPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Tag="L:common.cancel" IsCancel="True" Width="90" />
            <Button Content="Lưu tùy chọn" Tag="L:common.saveOptions" IsDefault="True" Width="120" Margin="0"
                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
